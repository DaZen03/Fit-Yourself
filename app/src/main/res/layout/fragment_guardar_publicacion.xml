<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondogris"
    tools:context=".ui.GuardarPublicacion">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTituloFormulario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/jockeyone_regular"
                android:text="Registrar Entrenamiento"
                android:textColor="@color/black"
                android:textSize="32sp" />

            <EditText
                android:id="@+id/eNombreRutina"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/textonormal"
                android:hint="Nombre de la Rutina (ej. Pecho)"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/eNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/textonormal"
                android:hint="Ejercicio (ej. Press de Banca)"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ePesoKg"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/textonormal"
                    android:hint="Peso (Kg)"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:textColor="@color/black" />

                <EditText
                    android:id="@+id/eRepeticiones"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/textonormal"
                    android:hint="Repeticiones"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:textColor="@color/black" />
            </LinearLayout>

            <EditText
                android:id="@+id/eDuracion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/textonormal"
                android:hint="Duración (minutos)"
                android:inputType="number"
                android:paddingStart="12dp"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/btnTomarfoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/jockeyone_regular"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/verde_alien"/>

            <ImageView
                android:id="@+id/fotoPrev"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible"
                />


            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/verde_alien"
                android:fontFamily="@font/jockeyone_regular"
                android:text="Guardar Entrenamiento"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>